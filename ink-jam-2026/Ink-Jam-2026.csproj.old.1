<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>InkJam2026</RootNamespace>
  </PropertyGroup>
  <Import Project="addons\GodotInk\GodotInk.props" />
    <!-- added by the 2dog tool: properties 2dog hosts need that were not already set -->
    <PropertyGroup>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DefineConstants>$(DefineConstants);LIBGODOT_ENABLED</DefineConstants>
        <DefaultItemExcludes>$(DefaultItemExcludes);Ink-Jam-2026.2dog/**;Ink-Jam-2026.web/**;Ink-Jam-2026.tests/**</DefaultItemExcludes>
    </PropertyGroup>
    <!-- added by the 2dog tool: compiles the web bootstrap (in the web host folder) into this game assembly -->
    <ItemGroup>
        <Compile Include="Ink-Jam-2026.web/TwoDogWebBoot.cs" Condition="Exists('$(MSBuildThisFileDirectory)Ink-Jam-2026.web/TwoDogWebBoot.cs')" />
    </ItemGroup>
</Project>